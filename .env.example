# =============================================================================
# Lynx Scan + Lynx GEO environment
# Copy to `.env` and edit. Never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Public URLs
# Local development defaults work with `npm run dev` / `npm run dev:all`.
# For production behind Nginx Proxy Manager, use HTTPS public domains and rebuild
# images so NEXT_PUBLIC_* values are baked into the client bundle.
# -----------------------------------------------------------------------------
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_GEO_URL=http://localhost:3010
NEXT_PUBLIC_LYNXSCAN_URL=http://localhost:3000

# Production example (Proxmox + NPM):
# APP_URL=https://lynxscan.condor616.com
# NEXTAUTH_URL=https://lynxscan.condor616.com
# NEXT_PUBLIC_GEO_URL=https://lynxgeo.condor616.com
# NEXT_PUBLIC_LYNXSCAN_URL=https://lynxscan.condor616.com

# Optional: share the session cookie across both app hostnames.
# Use the parent domain with a leading dot. Requires HTTPS in production.
# AUTH_COOKIE_DOMAIN=.condor616.com

# When true (recommended behind Nginx Proxy Manager), trust X-Forwarded-For /
# X-Real-IP for rate limiting. Only enable when a trusted reverse proxy sits in front.
TRUST_PROXY=false

# Published host ports for docker-compose.prod.yml (optional overrides)
# LYNXSCAN_HOST_PORT=3001
# LYNXGEO_HOST_PORT=3010

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_USER=lynx_scan
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=lynx_scan
# Optional full URL (Compose production stack sets this automatically to use host `db`)
# DATABASE_URL=postgres://lynx_scan:your_secure_password@localhost:5432/lynx_scan

# -----------------------------------------------------------------------------
# Redis / queues
# Local Next.js talks to published Redis; containers use service hostname `redis`.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Optional Redis AUTH for production (also set in compose if used):
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Cloudflare challenge solver (FlareSolverr)
# Local Compose publishes port 8191. Production compose keeps it internal only.
# -----------------------------------------------------------------------------
FLARESOLVERR_URL=http://localhost:8191/v1
FLARESOLVERR_PORT=8191
# FLARESOLVERR_LOG_LEVEL=info
# TZ=UTC

# -----------------------------------------------------------------------------
# Auth
# Required: minimum 32 characters.
# Generate with: openssl rand -hex 32
# Also used to derive the AES-256-GCM key that encrypts SMTP passwords inside
# backup archives. Restore decrypts with the same JWT_SECRET; changing it will
# prevent restoring credentials from older backups.
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_a_64_char_secret_generated_for_your_env

# -----------------------------------------------------------------------------
# Local-only admin tools (docker/services stack — NOT used by docker-compose.prod.yml)
# Change these before exposing pgAdmin on any network you do not fully trust.
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@lynxscan.com
PGADMIN_PASSWORD=change_me_before_use

# -----------------------------------------------------------------------------
# Workers
# -----------------------------------------------------------------------------
# BULLMQ_CONCURRENCY=10
# BULLMQ_CONCURRENCY_GEO=2
# ENABLE_BULL_BOARD=false

# -----------------------------------------------------------------------------
# SMTP (optional — pending-user notifications, password reset)
# SMTP_SECURE: none | starttls | tls
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=26
SMTP_SECURE=none
SMTP_USER=
SMTP_PASS=
SMTP_FROM=lynxscan@example.com
# Extra inbox for "new user pending approval" notices (in addition to ADMIN accounts).
MAIL_ADMIN=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database Configuration
POSTGRES_USER=lynx_scan
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=lynx_scan

# External Worker / Queue Configuration
REDIS_URL=redis://localhost:6379

# pgAdmin Configuration
PGADMIN_EMAIL=admin@lynxscan.com
PGADMIN_PASSWORD=admin

# Auth Configuration
# Required: minimum 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_a_64_char_secret_generated_for_your_env
# Optional: cookie Domain for sharing session across LynxScan and Lynx GEO hostnames.
# AUTH_COOKIE_DOMAIN=.example.com

# Public URL of the Lynx GEO (AI Audit) app. Used as a landing-page link from LynxScan.
NEXT_PUBLIC_GEO_URL=http://localhost:3010

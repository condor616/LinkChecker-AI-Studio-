# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database Configuration
POSTGRES_USER=lynx_scan
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=lynx_scan

# External Worker / Queue Configuration
REDIS_URL=redis://localhost:6379
# Cloudflare challenge solver (FlareSolverr). Started automatically with Docker.
# Local Next.js talks to the published port; the Docker worker uses the internal hostname.
FLARESOLVERR_URL=http://localhost:8191/v1
FLARESOLVERR_PORT=8191

# pgAdmin Configuration
PGADMIN_EMAIL=admin@lynxscan.com
PGADMIN_PASSWORD=admin

# Auth Configuration
# Required: minimum 32 characters.
# Generate one with: openssl rand -hex 32
# Also used to derive the AES-256-GCM key that encrypts SMTP passwords inside
# backup archives. Restore decrypts with the same JWT_SECRET; changing it will
# prevent restoring credentials from older backups.
JWT_SECRET=replace_with_a_64_char_secret_generated_for_your_env
# Optional: cookie Domain for sharing session across LynxScan and Lynx GEO hostnames.
# AUTH_COOKIE_DOMAIN=.example.com

# Public URL of the Lynx GEO (AI Audit) app. Used as a landing-page link from LynxScan.
NEXT_PUBLIC_GEO_URL=http://localhost:3010
# Public URL of LynxScan. Used as a signup link from Lynx GEO login.
NEXT_PUBLIC_LYNXSCAN_URL=http://localhost:3000

# SMTP
# Host, port, encryption (none | starttls | tls), optional username/password, and from address.
# SMTP_SECURE: none | starttls | tls
SMTP_HOST=
SMTP_PORT=26
SMTP_SECURE=none
SMTP_USER=
SMTP_PASS=
SMTP_FROM=lynxscan@example.com
# Extra inbox for "new user pending approval" notices (in addition to ADMIN accounts).
MAIL_ADMIN=

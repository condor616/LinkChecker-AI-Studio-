{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/worker",
    "noEmit": false,
    "module": "CommonJS",
    "target": "ES2020",
    "moduleResolution": "node"
  },
  "include": [
    "./**/*.ts",
    "../lib/**/*.ts",
    "../packages/crawler-core/src/**/*.ts",
    "../packages/auth/src/**/*.ts",
    "../packages/db/src/**/*.ts",
    "../packages/backup/src/**/*.ts"
  ],
  "exclude": ["../node_modules"]
}
